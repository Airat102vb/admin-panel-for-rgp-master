<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="author">
        <createTable tableName="player">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="race" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="profession" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="birthday" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="banned" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="experience" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="untilNextLevel" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="author">
        <renameColumn
                schemaName="public"
                tableName="player"
                oldColumnName="untilNextLevel"
                newColumnName="until_next_level"
                columnDataType="INTEGER"
                remarks="Change camel-case to snake-case"
        />
    </changeSet>

    <changeSet id="3" author="author">
        <createTable tableName="user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="login" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="registration" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="last_login" type="DATE">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="author">
        <addUniqueConstraint
                columnNames="login"
                constraintName="uk_user_login"
                tableName="user"/>

        <addUniqueConstraint
                columnNames="email"
                constraintName="uk_user_email"
                tableName="user"/>
    </changeSet>

    <changeSet id="5" author="author">
        <renameTable oldTableName="user" newTableName="users"/>
    </changeSet>

    <changeSet id="6" author="author">
        <createTable tableName="audit">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="login" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="date_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>